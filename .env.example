# ---------------------------------------------------------------------------
# Everything below is OPTIONAL. With no .env at all the app runs entirely on
# free, keyless OpenStreetMap services.
# ---------------------------------------------------------------------------

# Richer place details (ratings, reviews, photos, phone numbers).
# Without it, the detail panel shows only real OpenStreetMap data and says
# plainly when a field is unknown - it never invents values.
# Optional. Enables real ratings/photos/hours in the detail panel, and lets a
# name taken from a pasted Google share link be resolved through Google itself -
# which is the only source guaranteed to hold the place that link meant.
GOOGLE_PLACES_API_KEY=

# Where the place cache lives. Defaults to ./data locally and /tmp on
# serverless platforms (which have no writable persistent disk).
# PLACES_DATA_DIR=

# Portable seed produced by `npm run ingest -- --export data/seed.json`.
# Loaded into an empty cache at startup - commit it to ship real data with a
# deployment that has no persistent disk.
# SEED_FILE=data/seed.json

# Restrict geocoding to specific countries, e.g. "id" or "id,my,sg".
# Empty means worldwide.
PLACES_COUNTRY_CODES=

# --- Tuning -----------------------------------------------------------------

# Time budget for the live fetch on a cold area, in milliseconds.
# DISCOVERY_BUDGET_MS=14000

# How long a scraped area is trusted before being re-scraped (default 7 days).
# COVERAGE_MAX_AGE_MS=604800000

# Set to 1 to disable the background top-up that runs after a cold search.
# DISABLE_BACKGROUND_INGEST=0

# Resolve text OpenStreetMap cannot place - a business OSM does not list, or a
# house number OSM does not carry - through Google Maps' public embed endpoint.
# One request per distinct text, cached in the database for 30 days, never on
# an autocomplete keystroke. This is automated access to Google Maps content,
# which Google's terms restrict, and it can stop working without notice. Set to
# 0 to turn it off; the OSM path is unaffected.
# GOOGLE_MAPS_RESOLVER=1
# GOOGLE_MAPS_MIN_INTERVAL_MS=800

# How long an area rests after a live fetch before it may be fetched again.
# Coverage does not always reach the threshold, and without this such an area
# re-fetches on every request - which is how the public Photon instance blocked
# us. Raise it if you are deploying against a shared upstream.
# LIVE_FETCH_COOLDOWN_MS=600000

# Photon is the request-path browse source: one request per category, run
# concurrently. It is a free public instance and defends itself - 8 concurrent
# requests drew HTTP 503s. Raise this only against your own Photon instance.
# PHOTON_CONCURRENCY=4
# PHOTON_URL=https://photon.komoot.io

# Nominatim now handles reverse geocoding, the autocomplete fallback and the
# background sweep. It asks for at most 1 request/second. Lower this only
# against your own Nominatim instance.
# NOMINATIM_MIN_INTERVAL_MS=1100
# NOMINATIM_URL=https://nominatim.openstreetmap.org

# Comma-separated Overpass mirrors, tried in order with failed ones demoted.
# OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# Sent to every OSM service. Please use a real contact address if you deploy
# this publicly - it is what the OSM operators ask for.
# OSM_USER_AGENT=sembarang-budal/2.0 (you@example.com)

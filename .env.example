# ---------------------------------------------------------------------------
# Everything below is OPTIONAL. With no .env at all the app runs entirely on
# free, keyless OpenStreetMap services.
# ---------------------------------------------------------------------------

# Richer place details (ratings, reviews, photos, phone numbers).
# Without it, the detail panel shows only real OpenStreetMap data and says
# plainly when a field is unknown - it never invents values.
GOOGLE_PLACES_API_KEY=

# Where the place cache lives. Defaults to ./data locally and /tmp on
# serverless platforms (which have no writable persistent disk).
# PLACES_DATA_DIR=

# Portable seed produced by `npm run ingest -- --export data/seed.json`.
# Loaded into an empty cache at startup - commit it to ship real data with a
# deployment that has no persistent disk.
# SEED_FILE=data/seed.json

# Restrict geocoding to specific countries, e.g. "id" or "id,my,sg".
# Empty means worldwide.
PLACES_COUNTRY_CODES=

# --- Tuning -----------------------------------------------------------------

# Time budget for the live fetch on a cold area, in milliseconds.
# DISCOVERY_BUDGET_MS=14000

# How long a scraped area is trusted before being re-scraped (default 7 days).
# COVERAGE_MAX_AGE_MS=604800000

# Set to 1 to disable the background top-up that runs after a cold search.
# DISABLE_BACKGROUND_INGEST=0

# Nominatim asks for at most 1 request/second. Lower this only against your own
# Nominatim instance.
# NOMINATIM_MIN_INTERVAL_MS=1100
# NOMINATIM_URL=https://nominatim.openstreetmap.org

# Comma-separated Overpass mirrors, tried in order with failed ones demoted.
# OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# Sent to every OSM service. Please use a real contact address if you deploy
# this publicly - it is what the OSM operators ask for.
# OSM_USER_AGENT=sembarang-budal/2.0 (you@example.com)
